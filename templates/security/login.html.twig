{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <!-- ***** Main Banner Area Start ***** -->
    <div class="container-fluid p-3" id="top">

            <div class="col-1 justify-content-center">
                <a href="/" class="btn btn-success">Accueil</a>
            </div>

            <div class="row justify-content-center mt-5">
                <div class="col-4 justify-content-center mt-5">
                    <div class="col">
                        <h2>Page de connexion</h2>
                        <p>Restez connecter pour être informé...</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger">
                            {{ error }}
                        </div>
                    {% endif %}

                        <form action="{{ path('app_login') }}" method="post" class="col p-3 alert-secondary rounded">
                            <label for="username">Email</label>
                            <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus><br>
                            <label for="password">Mot de passe</label>
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                            <input type="hidden" name="_csrf_token"value="{{ csrf_token('authenticate') }}">
                            <button class="btn btn-lg btn-primary mt-3" type="submit">
                                Connexion
                            </button>
                        </form>
                </div>
            </div>
    </div>
       
{% endblock %}
