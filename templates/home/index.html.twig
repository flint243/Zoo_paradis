			</div>
		</div>
		<div class="container">
			<div class="row images">
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Découvertes
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite1.jpg') }}" alt="">
					</div>
				</div>
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Actualités
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite2.jpeg') }}" alt="">
					</div>
				</div>
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Evènements du zoo
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite3.jpg') }}" alt="">
					</div>
				</div>
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Shoppings du zoo
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite4.jpg') }}" alt="">
					</div>
				</div>
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Animaux stars
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite5.avif') }}" alt="">
					</div>
				</div>
				<div class="col-2">
					<div class="thumb">
						<div class="icon">
							<a href="http://instagram.com">
								<h6>
									Cadeaux
								</h6>
								<i class="fa fa-instagram"></i>
							</a>
						</div>
						<img src="{{ asset('/assets/images/visite/visite6.jpg') }}" alt="">
					</div>
				</div>
			</div>
		</div>
	</section>

		<!-- ***** Réseuax sociaux Ends ***** -->

		<!-- ***** Vos avis Start ***** -->
	<div class="subscribe">
			<div class="row m-0 p-3 ">
				<h2>
					Donnez votre avis
				</h2>
			</div>
			
			<div class="row m-0 justify-content-around">
				<img src="{{ asset('/assets/images/habitat_aerien/paon/paon3.jpg') }}" class="col-sm-4" alt="Photo profile par defaut"/>
				<div class="col-sm-4 bg-info">
					<form action="{{ path('Accueil') }}" method="post">
						{{ form_start(form, {'attr': {'class': 'form'}}) }}
						<div
							class="mb-3">
							{# Le reste du formulaire d'avis #}
							{{ form_row(form.pseudo, {'attr': {'class': 'form-control'}}) }}
						</div>

						<div
							class="mb-3">
							{# Le reste du formulaire d'avis #}
							{{ form_row(form.commentaire, {'attr': {'class': 'form-control'}}) }}
						</div>

						<button class="btn btn-success" type="submit">
							Envoyer
						</button>

						{{ form_end(form) }}
					</form>
				</div>
			
				<div class="col-sm-4">
					<div class="row mt-5 p-3 justify-content-around">
						<div class="col">
							<ul>
								<li>
									Notre boutique souvenir:
									<br>
									<span>
										Forêt de Brosseliand
									</span>
								</li>
								<li>
									Téléphone:
									<br>
									<span>
										010-020-0340
									</span>
								</li>
								<li>
									Nos bureaux:
									<br>
									<span>
										Forêt de Brosseliand
									</span>
								</li>
							</ul>
						</div>
						<div class="col">
							<ul>
								<li>
									Horaires:
									<br>
									<span>
										07:30 AM - 9:30 PM Daily
									</span>
								</li>
								<li>
									Email:
									<br>
									<span>
										info@company.com
									</span>
								</li>
								<li>
									Réseaux sociaux:
									<br>
									<span>
										<a href="#">
											Facebook
										</a>
										,
										<a href="#">
											Instagram
										</a>
										,
										<a href="#">
