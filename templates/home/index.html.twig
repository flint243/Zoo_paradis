{% extends 'base.html.twig' %}

	{% block title %}
		Zoo paradis | Accueil
	{% endblock %}


	{% block body %}

		<!-- ***** Preloader Start ***** -->
	<div id="preloader">
		<div class="jumper">
			<div></div>
			<div></div>
			<div></div>
		</div>
	</div>
		<!-- ***** Preloader End ***** -->


		<!-- ***** Header Area Start ***** -->
	<header class="header-area header-sticky">
		<div class="connexion bg-light">
			{% if app.user %}
				<div class="mb-3 userConnect">
					Bonjour
					{{ app.user.nom }}
					{% if app.user %}
						<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle bg-light" alt="Photo profile par defaut" width="30px" height="30px"/>
					{% endif %}
				</div>
					<a href="{{ path('app_logout') }}" class="deconnexionBtn btn btn-danger">
						Déconnexion
					</a>
			{% else %}
				<a href="{{ path('app_login') }}" class="connexionBtn btn btn-success text-light">
					Connexion ici
				</a>
			{% endif %}
		</div>

		<div class="container">
			<div class="row">
				<div class="col-12">
					<nav
						class="main-nav">
						<!-- ***** Logo Start ***** -->
						<a href="/" class="mt-2 logo">
							<div class="row p-2 bg-light rounded">
								<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle" alt="Photo profile" width="30px" height="30px"/>
								<h4 class="text-success font-weight-bold">
									Zoo paradis
								</h4>
							</div>
						</a>
						<!-- ***** Logo End ***** -->

						<!-- ***** Menu Start ***** -->
						<ul class="nav">
							{% if is_granted('ROLE_SUPER_ADMIN') %}
								<li>
									<a href="/admin" class="adminBtn px-2 rounded bg-danger">
										Super Admin
									</a>
								</li>
							{% elseif is_granted('ROLE_EMPLOYE') %}
								<li>
									<a href="/employee-admin" class="adminBtn px-2 rounded bg-warning">
										Employé
									</a>
								</li>
							{% elseif is_granted('ROLE_VETERINAIRE') %}
								<li>
									<a href="/veterinaire-admin" class="adminBtn px-2 rounded bg-info">
										Vétérinaire
									</a>
								</li>
							{% endif %}
							<li class="scroll-to-section">
								<a href="/" class="active">
									Accueil
								</a>
							</li>
							<li>
								<a href="/about">
									A propos
								</a>
							</li>
							<li>
								<a href="/services">
									Nos services
								</a>
							</li>
							<li>
								<a href="/habitats">
									Les habitats
								</a>
							</li>
							<li>
								<a href="/contact">
									Contact
								</a>
							</li>
						</ul>

						<a class='menu-trigger'>
							<span>
								Menu
							</span>
						</a>
						<!-- ***** Menu End ***** -->
					</nav>
				</div>
			</div>
		</div>
	</header>
		<!-- ***** Header End ***** -->

		<!-- *****  Banner Start ***** -->
	<div class="main-banner accueil" id="top">
		<div class="row">
			<div class="col justify-content-center">
				<div class="leftSide">
					<div class="left-content">
						<div class="thumb">
							<div class="row inner-content titre_baniere">
								<h4>
									Bienvenus à Zoo paradis
								</h4>
								<p>
									Un havre de paix pour nos les animaux
								</p>
							</div>
							<img src="{{ asset('/assets/images/banieres/animal-group.jpg') }}" class="presentImg"  alt="">
						</div>
					</div>
				</div>

				<div class="right-content">
					<div class="row">
						<div class="col-lg-4">
							<div class="right-first-image">
								{% for habitat1 in habitat1 %}
									<div class="thumb">
										<div class="inner-content">
											<h4>
												Habitat {{ habitat1.nom }}
											</h4>
										</div>
										<div class="hover-content">
											<div class="inner">
												<h4>
													Habitat {{ habitat1.nom }}
												</h4>
												<div class="main-border-button">
													<a href="/habitats/aerien">
														Explorer
													</a>
												</div>
											</div>
										</div>
										{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<img src="{{ asset('uploadsHabitats/imagesHabitats/' ~ habitat1.habitatImage) }}" height="220px" alt="">
										</div>
									{% endfor %}
								</div>
							</div>
						</div>

						<div class="col-lg-4">
							<div class="right-first-image">
								{% for habitat2 in habitat2 %}
									<div class="thumb">
										<div class="inner-content">
											<h4>
												Habitat {{ habitat2.nom }}
											</h4>
										</div>
										<div class="hover-content">
											<div class="inner">
												<h4>
													Habitat {{ habitat2.nom }}
												</h4>
												<div class="main-border-button">
													<a href="/habitats/terrestre">
														Explorer
													</a>
												</div>
											</div>
										</div>

										{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<img src="{{ asset('uploadsHabitats/imagesHabitats/' ~ habitat2.habitatimage) }}" height="220px" alt="">
										</div>
									{% endfor %}
								</div>
							</div>
						</div>

						<div class="col-lg-4">
							<div class="right-first-image">
								{% for habitat3 in habitat3 %}
									<div class="thumb">
										<div class="inner-content">
											<h4>
												Habitat {{ habitat3.nom }}
											</h4>
										</div>
										<div class="hover-content">
											<div class="inner">
												<h4>
													Habitat {{ habitat3.nom }}
												</h4>
												<div class="main-border-button">
													<a href="/habitats/aquatique">
														Explorer
													</a>
												</div>
											</div>
										</div>

										{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<img src="{{ asset('uploadsHabitats/imagesHabitats/' ~ habitat3.habitatimage) }}" height="220px" alt="">
										</div>
									{% endfor %}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
		<!-- *****  Banner End ***** -->


		<!-- ***** Services Area Starts ***** -->
	<section class="section p-2" id="products">
        <div class="container">
            <div class="row p-0 mb-0">
                <div class="col-lg-12 p-0 mt-0">
                    <div class="section-heading p-0 mb-0">
                        <h2>Nos services</h2>
                        <span>Consultez nos services.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="container p-3">
            <div class="row">
                <div class="col-lg-4"> 
                    <div class="item">
                        <div class="thumb">
                                {% for services in services %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/restauration"><img src="{{ asset('uploads/services/' ~ services.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content p-1">
											<h4>
												{{ services.nom }}
											</h4>
											<span>
												{{ services.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                        
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="item">
                        <div class="thumb">
                                {% for services2 in services2 %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/habitats"><img src="{{ asset('uploads/services/' ~ services2.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content p-1">
											<h4>
												{{ services2.nom }}
											</h4>
											<span>
												{{ services2.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="item">
                        <div class="thumb">
                                {% for services3 in services3 %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/visites"><img src="{{ asset('uploads/services/' ~ services3.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content p-1">
											<h4>
												{{ services3.nom }}
											</h4>
											<span>
												{{ services3.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                    </div>
                </div>
        </div>
    </section>
		<!-- ***** Services Area Ends ***** -->

		<!-- ***** Explore Start ***** -->
	<section class="section" id="explore">
		<div class="container">
			<div class="row">

				<!--*****  SECTION   AVIS *****-->
				<div class="col temoignages ">
					<h3>
						Témoignages
					</h3>
					<h3>
						Nos invités sont ravis
					</h3>
				</div>

				<!--***** slider *****-->
				<section id="slideShowAvis">
					<div id="slider" class="slidere">
						{% for avis in avisList %}
							{% if avis.isValidated and (avis.id) %}
								<div
									class="slide">
									<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="bg-light border border-2 rounded-circle" width="35px" height="100px"/>
									<i class="fa-solid fa-quote-left"></i>
									<p class="text-light text-bold mt-5">
										{{ avis.commentaire }}
										<br>
										<strong>
											Nom: {{ avis.pseudo }}
										</strong>
									</p>
									<p class="text-light text-bold">
										Date :
										{{ avis.createdAt|date('d-m-Y') }}
									</p>
								</p>
							</div>
							{% endif %}
						{% endfor %}
						<div id="bandeauColor">
							<div id="InfoSlider"></div>
						</div>
					</div>
				</section>
				<!-- FIN slider -->

				<!--  FIN - SECTION AVIS - -->
			</div>
		</div>
	</section>
		<!-- ***** Explore Ends ***** -->

		<!-- ***** Réseuax sociaux Start ***** -->
	<section class="section" id="social">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="section-heading mt-5">
						<h2>
							Réseaux sociaux
						</h2>
