{% extends 'base.html.twig' %}

{% block title %}Zoo paradis | Contact {% endblock %}

{% block body %}

    <!-- ***** Preloader Start ***** -->
    <div id="preloader">
        <div class="jumper">
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>  
    <!-- ***** Preloader End ***** -->
    
    <!-- ***** Header Area Start ***** -->
    <header class="header-area header-sticky">
			<div class="connexion bg-light">
				{% if app.user %}
					<div class="mb-3 userConnect">
						Bonjour
						{{ app.user.nom }}
						{% if app.user.profileImage %}
							<img src="/uploadsUsers/imagesUsers/{{ app.user.profileImage }}" class="rounded-circle" width="40px" height="35px"/>
						{% else %}
							<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle bg-light" width="30px" height="30px"/>
						{% endif %}
					</div>

					<div class="deconnexionBtn btn btn-danger">
						<a href="{{ path('app_logout') }}">
							Déconnexion
						</a>
					</div>

				{% else %}
					<a href="{{ path('app_login') }}" class="connexionBtn">
						Connexion ici
					</a>
				{% endif %}
			</div>

			<div class="container">
				<div class="row">
					<div class="col-12">
						<nav
							class="main-nav">

							<!-- ***** Logo Start ***** -->
							<a href="/" class="mt-2 logo">
								<div class="row p-2 bg-light rounded">
									<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle" width="30px" height="30px"/>
									<h4 class="text-success font-weight-bold">
										Zoo paradis
									</h4>
								</div>
							</a>
							<!-- ***** Logo End ***** -->

							<!-- ***** Menu Start ***** -->
							<ul class="nav">
								{% if is_granted('ROLE_SUPER_ADMIN') %}
									<li>
										<a href="/admin" class="adminBtn px-2 rounded bg-danger">
											Super Admin
										</a>
									</li>
								{% elseif is_granted('ROLE_EMPLOYE') %}
									<li>
										<a href="/employee-admin" class="adminBtn px-2 rounded bg-warning">
											Employé
										</a>
									</li>
								{% elseif is_granted('ROLE_VETERINAIRE') %}
									<li>
										<a href="/veterinaire-admin" class="adminBtn px-2 rounded bg-info">
											Vétérinaire
										</a>
									</li>
								{% endif %}
								<li class="scroll-to-section">
									<a href="/">
										Accueil
									</a>
								</li>
								<li>
									<a href="/about">
										A propos
									</a>
								</li>
								<li>
									<a href="/services">
										Nos services
									</a>
								</li>
								<li>
									<a href="/habitats">
										Les habitats
									</a>
								</li>
                                <li>
									<a href="/" class="active">
										Contact
									</a>
								</li>
							</ul>

							<a class='menu-trigger'>
								<span>
									Menu
								</span>
							</a>
							<!-- ***** Menu End ***** -->
						</nav>
					</div>
				</div>
			</div>
		</header>
    <!-- ***** Header End ***** -->

    <!-- ***** Main Banner Area Start ***** -->
    <div class="page-heading about-page-heading" id="top">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="inner-content">
                        <h2>Contactez - nous</h2>
                        <span>Awesome, clean &amp; creative HTML5 Template</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Main Banner Area End ***** -->

    <!-- ***** Contact Area Starts ***** -->
    <div class="contact-us">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div id="map">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2669.461277127928!2d-2.290752987609493!3d48.0047974711091!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x480fb38fd5df5933%3A0x23f241c31b5da661!2sFor%C3%AAt%20de%20Broceliande%2C%20Val%20sans%20Retour!5e0!3m2!1sfr!2sfr!4v1726416390852!5m2!1sfr!2sfr" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>                      <!-- You can simply copy and paste "Embed a map" code from Google Maps for any location. -->        
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="section-heading">
                        <h2>Laissez nous un message</h2>
                        <span>Details to details is what makes Hexashop different from the other themes.</span>
                    </div>

                     {% for label, messages in app.flashes %}
                        {% if label == 'success_contact' %}
                            {# Afficher uniquement les messages de succès du formulaire de contact #}
                            {% for message in messages %}
                                <div class="alert alert-success">
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}

                    {{ form_start(ContactForm, {'attr': {'class': 'form'}}) }}
                        <div class="row p-3">
                          <div class="col-lg-6">
                            <fieldset>
                                {{ form_widget(ContactForm.titre, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(ContactForm.titre, {'attr': {'class': 'text-danger'}}) }}
                            </fieldset>
                          </div>
                          <div class="col-lg-6">
                            <fieldset>
                                {{ form_widget(ContactForm.email, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(ContactForm.email, {'attr': {'class': 'text-danger'}}) }}
                            </fieldset>
                          </div>
                          <div class="col-lg-12">
                            <fieldset>
                                {{ form_widget(ContactForm.description, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(ContactForm.description, {'attr': {'class': 'text-danger'}}) }}
                            </fieldset>
                          </div>
                        </div>
                      {{ form_end(ContactForm) }}
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Contact Area Ends ***** -->

    <div class="col newsSection pt-2 justify-content-center">
        <div class="container newsletter mt-2">
            <h1>Inscrivez-vous à notre newsletter</h1>
            <div class="col messages">
                {% for label, messages in app.flashes %}
                    {% if label == 'success_newsletter' %}
                        {# Afficher uniquement les messages de succès du formulaire de newsletter #}
                        {% for message in messages %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% elseif label == 'warning_newsletter' %}
                        {# Afficher un avertissement si l'email est déjà inscrit à la newsletter #}
                        {% for message in messages %}
                            <div class="alert alert-warning">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>

            <div class="col-lg-6 form mt-5 p-3">
                {{ form_start(formSub) }}
                    {{ form_row(formSub.email) }}
                    {{ form_row(formSub.rgpd) }}
                    <div class="row">
                    <p class="rgpd-info">Pour plus d'informations sur la gestion de vos données personnelles et pour exercer vos droits,
                    consultez notre <a href="{{ path('Accueil') }}" target="_blank">politique de confidentialité</a>
                    </p>
                    </div>
                    <button class="btn btn-primary mt-2">S'inscrire</button>
                {{ form_end(formSub) }}
             </div>
        </div>
    </div>



   <!-- ***** Footer Start ***** -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-3">
                    <div class="first-item">
                        <div class="row logo justify-content-around">
                            <img src="{{ asset('/assets/images/avatar/avatar2.png') }}" width="30px" height="30px" />
                                <h3 class="text-success font-weight-bold">Zoo paradis</h3>
                            </div>
                        <ul>
                            <li><a href="#">Forêt de Brocéliand</a></li>
                            <li><a href="#">zoo-paradis@broceliand.com</a></li>
                            <li><a href="#">05.24.77.43.11</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3">
                    <h4>Shopping &amp; Categories</h4>
                    <ul>
                        <li><a href="#">Men’s Shopping</a></li>
                        <li><a href="#">Women’s Shopping</a></li>
                        <li><a href="#">Kid's Shopping</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Liens éssentiels</h4>
                    <ul>
                        <li><a href="#">Homepage</a></li>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Help</a></li>
                        <li><a href="#">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Information</h4>
                    <ul>
                        <li><a href="#">Aide</a></li>
                        <li><a href="#">FAQ's</a></li>
                        <li><a href="#">Shipping</a></li>
                        <li><a href="#">Tracking ID</a></li>
                    </ul>
                </div>
                <div class="col-lg-12">
                    <div class="under-footer">
                        <p>Copyright © 2024 Zoo paradis., tout droit Réservés. 
                        
                        <br>Design: <a href="https://templatemo.com" target="_parent" title="free css templates">Limay</a>

                        <br>Distribué par: <a href="https://themewagon.com" target="_blank" title="free & premium responsive templates">ASSOFAC MONTREUIL</a></p>
                        <ul>
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                            <li><a href="#"><i class="fa fa-behance"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
    </footer>
{% endblock %}
