    {% block javascripts %}

        <script>
            document.querySelectorAll('.clickableImage').forEach(image => {
                image.addEventListener('click', function() {
                    const terrestreId = this.getAttribute('data-id');

                    fetch('/increment-click-terrestre', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ terrestreId: terrestreId })
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! Status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log(`Image ${terrestreId} clicked! New count:`, data.new_count);
                        
                        // Redirige l'utilisateur vers la page correspondante après l'incrémentation
                        window.location.href = this.href;
                    })
                    .catch(error => console.error('Error:', error));
                });
            });
    </script>

    {% endblock %}

    {% endblock %}