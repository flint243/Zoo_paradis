{% extends 'base.html.twig' %}

{% block title %}Zoo paradis | Habitat terretre{% endblock %}

{% block body %}
<!-- ***** Preloader Start ***** -->
    <div id="preloader">
        <div class="jumper">
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>  
    <!-- ***** Preloader End ***** -->
    
    
    <!-- ***** Header Area Start ***** -->
    <header class="header-area header-sticky">
			<div class="connexion bg-light">
				{% if app.user %}
					<div class="mb-3 userConnect">
						Bonjour
						{{ app.user.nom }}
						{% if app.user.profileImage %}
							<img src="/uploadsUsers/imagesUsers/{{ app.user.profileImage }}" class="rounded-circle" width="40px" height="35px"/>
						{% else %}
							<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle bg-light" width="30px" height="30px"/>
						{% endif %}
					</div>

					<div class="deconnexionBtn btn btn-danger">
						<a href="{{ path('app_logout') }}">
							Déconnexion
						</a>
					</div>

				{% else %}
					<a href="{{ path('app_login') }}" class="connexionBtn">
						Connexion ici
					</a>
				{% endif %}
			</div>

			<div class="container">
				<div class="row">
					<div class="col-12">
						<nav
							class="main-nav">

							<!-- ***** Logo Start ***** -->
							<a href="/" class="mt-2 logo">
								<div class="row p-2 bg-light rounded">
									<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle" width="30px" height="30px"/>
									<h4 class="text-success font-weight-bold">
										Zoo paradis
									</h4>
								</div>
							</a>
							<!-- ***** Logo End ***** -->

							<!-- ***** Menu Start ***** -->
							<ul class="nav">
								{% if is_granted('ROLE_SUPER_ADMIN') %}
									<li>
										<a href="/admin" class="adminBtn px-2 rounded bg-danger">
											Super Admin
										</a>
									</li>
								{% elseif is_granted('ROLE_EMPLOYE') %}
									<li>
										<a href="/employee-admin" class="adminBtn px-2 rounded bg-warning">
											Employé
										</a>
									</li>
								{% elseif is_granted('ROLE_VETERINAIRE') %}
									<li>
										<a href="/veterinaire-admin" class="adminBtn px-2 rounded bg-info">
											Vétérinaire
										</a>
									</li>
								{% endif %}
								<li class="scroll-to-section">
									<a href="/">
										Accueil
									</a>
								</li>
								<li>
									<a href="/about">
										A propos
									</a>
								</li>
								<li>
									<a href="/services">
										Nos services
									</a>
								</li>
                                <li>
									<a href="/habitats" class="active">
										Nos habitats
									</a>
								</li>
								<li>
									<a href="/contact">
										Contact
									</a>
								</li>

								{#<li class="scroll-to-section"><a href="#men">Eau</a></li></ul></li>#}
							</ul>

							<a class='menu-trigger'>
								<span>
									Menu
								</span>
							</a>
							<!-- ***** Menu End ***** -->
						</nav>
					</div>
				</div>
			</div>
		</header>
    <!-- ***** Header Area End ***** -->

    <!-- ***** Main Banner Area Start ***** -->
    <div class="page-heading terrestre" id="top">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="inner-content">
                        <h2>Voici le détail de l'habitat terrestre</h2>
                        <span>Awesome &amp; Creative HTML CSS layout by TemplateMo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Main Banner Area End ***** -->

             <!-- ***** Habitat terrestre Starts ***** -->
    <section class="section" id="women">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="section-heading">
                        <h2>L'habitat terrestre</h2>
                        <span>Venez explorer le monde des animaux terrestre.</span>
                    </div>
                </div>
            </div>
        </div>
            <div class="container">
                <div class="col-lg-12">
                    <div class="women-item-carousel">
                        <div class="owl-women-item owl-carousel">
                            {% for terrestre in terrestre %}
                            <div class="item">
                                <div class="thumb">
                                    <div class="hover-content">
                                        <ul>
                                            <li>
                                                <a href="{{ path('show_terrestreId', {id: terrestre.id}) }}" class="clickableImage" data-id="{{ terrestre.id }}">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <img src="{{ asset('uploadsAnimals/imagesAnimals/' ~ terrestre.imagesAnimal) }}"alt="Image de {{ terrestre.prenom }}">
                                </div>
                                <div class="down-content">
                                     {{ terrestre.prenom }}
                                    <h4>{{ terrestre.race }}</h4>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
    <!-- ***** Habitat terrestre Ends ***** -->
                
   

     <!-- ***** Footer Start ***** -->
