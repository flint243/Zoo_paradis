{% extends 'base.html.twig' %}

{% block title %}Zoo paradis | Nos Services{% endblock %}

{% block body %}
<!-- ***** Preloader Start ***** -->
    <div id="preloader">
        <div class="jumper">
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>  
    <!-- ***** Preloader End ***** -->
    
    
    <!-- ***** Header Area Start ***** -->
    <header class="header-area header-sticky">
		<div class="connexion bg-light">
			{% if app.user %}
				<div class="mb-3 userConnect">
					Bonjour
					{{ app.user.nom }}
					{% if app.user %}
						<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle bg-light" width="30px" height="30px"/>
					{% endif %}
				</div>

				<a href="{{ path('app_logout') }}" class="deconnexionBtn btn btn-danger">
						Déconnexion
					</a>
			{% else %}
				<a href="{{ path('app_login') }}" class="connexionBtn btn btn-success text-light">
					Connexion ici
				</a>
			{% endif %}
		</div>

		<div class="container">
			<div class="row">
				<div class="col-12">
					<nav
						class="main-nav">

						<!-- ***** Logo Start ***** -->
						<a href="/" class="mt-2 logo">
							<div class="row p-2 bg-light rounded">
								<img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle" width="30px" height="30px"/>
								<h4 class="text-success font-weight-bold">
									Zoo paradis
								</h4>
							</div>
						</a>
						<!-- ***** Logo End ***** -->

						<!-- ***** Menu Start ***** -->
						<ul class="nav">
							{% if is_granted('ROLE_SUPER_ADMIN') %}
								<li>
									<a href="/admin" class="adminBtn px-2 rounded bg-danger">
										Super Admin
									</a>
								</li>
							{% elseif is_granted('ROLE_EMPLOYE') %}
								<li>
									<a href="/employee-admin" class="adminBtn px-2 rounded bg-warning">
										Employé
									</a>
								</li>
							{% elseif is_granted('ROLE_VETERINAIRE') %}
								<li>
									<a href="/veterinaire-admin" class="adminBtn px-2 rounded bg-info">
										Vétérinaire
									</a>
								</li>
							{% endif %}
							<li class="scroll-to-section">
								<a href="/">
									Accueil
								</a>
							</li>
							<li>
								<a href="/about">
									A propos
								</a>
							</li>
							<li>
								<a href="/" class="active">
									Services
								</a>
							</li>
							<li>
								<a href="/habitats">
									Les habitats
								</a>
							</li>
							<li>
								<a href="/contact">
									Contact
								</a>
							</li>

							{#<li class="scroll-to-section"><a href="#men">Eau</a></li></ul></li>#}
						</ul>

						<a class='menu-trigger'>
							<span>
								Menu
							</span>
						</a>
						<!-- ***** Menu End ***** -->
					</nav>
				</div>
			</div>
		</div>
	</header>
    <!-- ***** Header Area End ***** -->

    <!-- ***** Main Banner Area Start ***** -->
    <div class="page-heading services" id="top">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="inner-content">
                        <h2>Nos services</h2>
                        <span>Awesome &amp; Creative HTML CSS layout by TemplateMo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ***** Main Banner Area End ***** -->


    <!-- ***** Products Area Starts ***** -->
    <section class="section p-2" id="products">
        <div class="container">
            <div class="row p-0 mb-0">
                <div class="col-lg-12 p-0 mt-0">
                    <div class="section-heading p-0 mb-0">
                        <h2>Nos services</h2>
                        <span>Check out all of our products.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="container p-3">
            <div class="row">
                <div class="col-lg-4"> 
                    <div class="item">
                        <div class="thumb">
                                {% for services in services %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/restauration"><img src="{{ asset('uploads/services/' ~ services.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content">
											<h4>
												{{ services.nom }}
											</h4>
											<span>
												{{ services.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                        
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="item">
                        <div class="thumb">
                                {% for services2 in services2 %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/habitats"><img src="{{ asset('uploads/services/' ~ services2.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content">
											<h4>
												{{ services2.nom }}
											</h4>
											<span>
												{{ services2.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="item">
                        <div class="thumb">
                                {% for services3 in services3 %}
									{# Ici, tu n'accèdes plus à .id car services est une chaîne #}
										<div>
											<a href="/visites"><img src="{{ asset('uploads/services/' ~ services3.servicesImages) }}"height="250px" alt=""></a>
										</div>
										<div class="down-content">
											<h4>
												{{ services3.nom }}
											</h4>
											<span>
												{{ services3.description }}
											</span>
										</div>
								{% endfor %}
                        </div>
                    </div>
                </div>
        </div>
    </section>
    <!-- ***** Products Area Ends ***** -->

    <!-- ***** Footer Start ***** -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-3">
                    <div class="first-item">
                        <div class="row logo justify-content-around">
                            <img src="{{ asset('/assets/images/avatar/avatar2.png') }}" width="30px" height="30px" />
                                <h3 class="text-success font-weight-bold">Zoo paradis</h3>
                            </div>
                        <ul>
                            <li><a href="#">Forêt de Brocéliand</a></li>
                            <li><a href="#">zoo-paradis@broceliand.com</a></li>
                            <li><a href="#">05.24.77.43.11</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3">
                    <h4>Shopping &amp; Categories</h4>
                    <ul>
                        <li><a href="#">Men’s Shopping</a></li>
                        <li><a href="#">Women’s Shopping</a></li>
                        <li><a href="#">Kid's Shopping</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Liens éssentiels</h4>
                    <ul>
                        <li><a href="#">Homepage</a></li>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Help</a></li>
                        <li><a href="#">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Information</h4>
                    <ul>
                        <li><a href="#">Aide</a></li>
                        <li><a href="#">FAQ's</a></li>
                        <li><a href="#">Shipping</a></li>
                        <li><a href="#">Tracking ID</a></li>
                    </ul>
                </div>
                <div class="col-lg-12">
                    <div class="under-footer">
                        <p>Copyright © 2024 Zoo paradis., tout droit Réservés. 
                        
                        <br>Design: <a href="https://templatemo.com" target="_parent" title="free css templates">Limay</a>

                        <br>Distribué par: <a href="https://themewagon.com" target="_blank" title="free & premium responsive templates">ASSOFAC MONTREUIL</a></p>
                        <ul>
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                            <li><a href="#"><i class="fa fa-behance"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
    </footer>
{% endblock %}
