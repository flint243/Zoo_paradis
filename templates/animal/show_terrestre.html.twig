{% extends 'base.html.twig' %}

{% block title %}Zoo paradis | Habitat terrestre{% endblock %}

{% block body %}
    <!-- ***** Header Area Start ***** -->
        <header class="header-area header-sticky">
            <div class="connexion bg-light">
                {% if app.user %}
                    <div class="mb-3 userConnect">
                        Bonjour
                        {{ app.user.nom }}
                        {% if app.user %}
                            <img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle bg-light" alt="Photo profile par defaut" width="30px" height="30px"/>
                        {% endif %}
                    </div>
                        <a href="{{ path('app_logout') }}" class="deconnexionBtn btn btn-danger">
                            Déconnexion
                        </a>
                
                {% endif %}
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <nav
                            class="main-nav">
                            <!-- ***** Logo Start ***** -->
                            <a href="/" class="mt-2 logo">
                                <div class="row p-2 bg-light rounded">
                                    <img src="{{ asset('/assets/images/avatar/avatar2.png') }}" class="rounded-circle" alt="Photo profile" width="30px" height="30px"/>
                                    <h4 class="text-success font-weight-bold">
                                        Zoo paradis
                                    </h4>
                                </div>
                            </a>
                            <!-- ***** Logo End ***** -->

                            <!-- ***** Menu Start ***** -->
                            <ul class="nav">
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <li>
                                        <a href="/admin" class="adminBtn px-2 rounded bg-danger">
                                            Super Admin
                                        </a>
                                    </li>
                                {% elseif is_granted('ROLE_EMPLOYE') %}
                                    <li>
                                        <a href="/employee-admin" class="adminBtn px-2 rounded bg-warning">
                                            Employé
                                        </a>
                                    </li>
                                {% elseif is_granted('ROLE_VETERINAIRE') %}
                                    <li>
                                        <a href="/veterinaire-admin" class="adminBtn px-2 rounded bg-info">
                                            Vétérinaire
                                        </a>
                                    </li>
                                {% endif %}
                                <li class="scroll-to-section">
                                    <a href="/" class="active">
                                        Accueil
                                    </a>
                                </li>
                                <li>
                                    <a href="/about">
                                        A propos
                                    </a>
                                </li>
                                <li>
                                    <a href="/services">
                                        Nos services
                                    </a>
                                </li>
                                <li>
                                    <a href="/habitats">
                                        Les habitats
                                    </a>
                                </li>
                                <li>
                                    <a href="/contact">
                                        Contact
                                    </a>
                                </li>
                            </ul>

                            <a class='menu-trigger'>
                                <span>
                                    Menu
                                </span>
                            </a>
                            <!-- ***** Menu End ***** -->
                        </nav>
                    </div>
                </div>
            </div>
        </header>
	<!-- ***** Header End ***** -->

<div class="container-fluid p-3 mt-6">
 <div class="row boutons justify-content-center p-3 mt-5">
            <button class="btn btn-success m-2"><a href="/habitats/terrestre"> Retour </a></button>
            <button class="btn btn-success m-2"><a href="/habitats/">Habitats </a></button>
        </div>
      
    <div class="col large p-3 mb-5">
         {% if terrestre %}
         <div class="row cadreSingle justify-content-center">
            <div class="col-6 cadreSingleInt bg-light text-center mb-5">
                <h4> {{ terrestre.prenom }}</h4>
                <img src="{{ asset('uploadsAnimals/imagesAnimals/' ~ terrestre.imagesanimal) }}"class="singleImage" alt="Image de {{ terrestre.prenom }}">
                    <div class="col">
                        <span>{{ terrestre.race }}</span>
                        <p>{{ clickCount }} <i class="fa fa-eye"></i></p>
                    </div>            
            </div>
        </div>  
            <div class="row infos bg-light p-3 justify-content-around">
                <div class="col-auto-sm-4 mb-5"><h2>Etat de {{ terrestre.prenom }}:</h2>
                <p>Etat de l'animal</p>
                </div>
                <div class="col-auto-sm-4 mb-5"><h2>Alimentation de {{ terrestre.prenom }}:</h2>
                <p>Alimentation de l'animal</p>
                </div>
                <div class="col-auto-sm-4 mb-5"><h2>Autres infos sur {{ terrestre.prenom }}:</h2>
                <p>Autres infos sur l'animal</p>
                </div>
            </div>      
         {% endif %}
    </div>
       
</div>
{% endblock %}
