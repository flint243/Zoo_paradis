{% extends 'base.html.twig' %}

{% block title %}Zoo paradis | Habitat Aérien{% endblock %}

{% block body %}

<div class="container justify-content-center">
       {% if aerien %}
    <div class="row">
        <div class="justify-content-around px-0 py-3">
            <button class="btn btn-success"><a href="/habitats/aerien"> Retour </a></button>
            <button class="btn btn-success"><a href="/habitats/">Habitats </a></button>
        </div>
        <div class="col-12 bg-light text-center py-4">
            <h4> {{ aerien.prenom }}</h4>
            <img src="{{ asset('uploadsAnimals/imagesAnimals/' ~ aerien.imagesanimal) }}"class="singleImage" alt="Image de {{ aerien.prenom }}">
                <div class="down-content">
                    <span>{{ aerien.race }}</span>
                   <p>{{ clickCount }} <i class="fa fa-eye"></i></p>
                </div>            
        </div>
    </div>
        {% endif %}
</div>



{% endblock %}
